msgstr "(pagrindinis šriftas)"

#: frontend/apps/reader/modules/readerfont.lua:478
msgid "Use main font"
msgstr "Naudoti pagrindinį šriftą"

#: frontend/apps/reader/modules/readerfont.lua:481
