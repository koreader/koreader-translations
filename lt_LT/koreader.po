#: frontend/ui/data/koptoptions.lua:462
msgctxt "Word gap"
msgid "large"
msgstr "didelis"

#: frontend/ui/data/koptoptions.lua:469
msgid "In reflow mode, sets the spacing between words."
msgstr "Perkėlimo režime nustato tarpus tarp žodžių."

#. @translators Reflow text.
#: frontend/ui/data/koptoptions.lua:474
msgid "Reflow"
msgstr "Perkėlimas"

#: frontend/ui/data/koptoptions.lua:475
msgctxt "Reflow"
msgid "off"
msgstr "išjungta"

#: frontend/ui/data/koptoptions.lua:475
msgctxt "Reflow"
msgid "on"
msgstr "įjungta"

#: frontend/ui/data/koptoptions.lua:480
msgid ""
"Reflow mode extracts text and images from the original document, possibly "
"discarding some formatting, and reflows it on the screen for easier "
"reading.\n"
"Some of the other settings are only available when reflow mode is enabled."
msgstr ""
"Perkėlimo režimas išgauna tekstą ir paveikslėlius iš originalaus dokumento, "
"galimai atsisakydamas dalies formatavimo, ir perkelia jį ekrane, kad būtų "
"lengviau skaityti.\n"
"Kai kurie kiti nustatymai prieinami tik įjungus perkėlimo režimą."

#: frontend/ui/data/koptoptions.lua:511
msgid "Saturation"
msgstr "Sodrumas"

#: frontend/ui/data/koptoptions.lua:530
msgid ""
"Adjust color saturation for rendered pages.\n"
"Lower values desaturate colors, 1.0 keeps original colors, and higher values "
"increase color intensity."
msgstr ""
"Koreguoti spalvų sodrumą atvaizduojamiems puslapiams.\n"
"Mažesnės reikšmės nusodrina spalvas, 1.0 palieka originalias spalvas, o "
"didesnės reikšmės padidina spalvų intensyvumą."

#: frontend/ui/data/koptoptions.lua:535
msgid "White Threshold"
msgstr "Baltos spalvos riba"

#: frontend/ui/data/koptoptions.lua:549
msgid "Render everything above the threshold white."
msgstr "Atvaizduoti viską virš ribos baltai."

#: frontend/ui/data/koptoptions.lua:553
msgid "Dewatermark"
msgstr "Pašalinti vandens ženklą"

#: frontend/ui/data/koptoptions.lua:554
msgctxt "Dewatermark"
msgid "off"
msgstr "išjungta"

#: frontend/ui/data/koptoptions.lua:554
msgctxt "Dewatermark"
msgid "on"
msgstr "įjungta"

#: frontend/ui/data/koptoptions.lua:561
msgid ""
"Remove watermarks from the rendered document.\n"
"This can also be used to remove some gray background or to convert a "
"grayscale or color document to black & white and get more contrast for "
"easier reading."
msgstr ""
"Pašalinti vandens ženklus iš atvaizduojamo dokumento.\n"
"Tai taip pat galima naudoti norint pašalinti pilką foną ar konvertuoti pilkų "
"atspalvių ar spalvotą dokumentą į juodą ir baltą, kad būtų didesnis "
"kontrastas skaitymui palengvinti."

#: frontend/ui/data/koptoptions.lua:566
msgid "Background Cleanup"
msgstr "Fono valymas"

#: frontend/ui/data/koptoptions.lua:567
msgctxt "Background Cleanup"
msgid "off"
msgstr "išjungta"

#: frontend/ui/data/koptoptions.lua:567
msgctxt "Background Cleanup"
msgid "on"
msgstr "įjungta"

#: frontend/ui/data/koptoptions.lua:575
msgid ""
"Render the essentials in black and white, ignoring extra data for better "
"contrast and faster rendering.\n"
"Useful for Internet Archive PDF documents."
msgstr ""
"Atvaizduoti tik esminius dalykus juodai baltai, ignoruojant papildomus "
"duomenis geresniam kontrastui ir greitesniam atvaizdavimui.\n"
"Naudinga Internet Archive PDF dokumentams."

#: frontend/ui/data/koptoptions.lua:580 frontend/ui/data/koptoptions.lua:593
msgid "Dithering"
msgstr "Raibuliavimas (dithering)"

#: frontend/ui/data/koptoptions.lua:581 frontend/ui/data/koptoptions.lua:594
msgctxt "Dithering"
msgid "off"
msgstr "išjungta"

#: frontend/ui/data/koptoptions.lua:581 frontend/ui/data/koptoptions.lua:594
msgctxt "Dithering"
msgid "on"
msgstr "įjungta"

#: frontend/ui/data/koptoptions.lua:589
msgid "Enable hardware dithering."
msgstr "Įjungti aparatinį raibuliavimą."

#: frontend/ui/data/koptoptions.lua:602
msgid "Enable software dithering."
msgstr "Įjungti programinį raibuliavimą."

#: frontend/ui/data/koptoptions.lua:606
msgctxt "Quality"
msgid "Render Quality"
msgstr "Atvaizdavimo kokybė"

#: frontend/ui/data/koptoptions.lua:607
msgctxt "Quality"
