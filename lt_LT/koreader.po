#: frontend/ui/data/koptoptions.lua:408
msgctxt "Alignment"
msgid "auto"
msgstr "auto"

#: frontend/ui/data/koptoptions.lua:409
msgctxt "Alignment"
msgid "left"
msgstr "kairėje"

#: frontend/ui/data/koptoptions.lua:410
msgctxt "Alignment"
msgid "center"
