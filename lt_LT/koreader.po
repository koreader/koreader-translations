msgstr "Ar tikrai norite įrašyti visus KOReader paryškinimus į PDF failą?"

#: frontend/apps/reader/modules/readerhighlight.lua:698
msgid "1 highlight written into PDF file"
msgid_plural "%1 highlights written into PDF file"
msgstr[0] "Į PDF failą įrašytas 1 paryškinimas"
msgstr[1] "Į PDF failą įrašyti %1 paryškinimai"
msgstr[2] "Į PDF failą įrašyta %1 paryškinimo"
msgstr[3] "Į PDF failą įrašyta %1 paryškinimų"

