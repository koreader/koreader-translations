msgstr[1] "%1 paryškinimai ištrinti iš PDF failo"
msgstr[2] "%1 paryškinimų ištrinta iš PDF failo"
msgstr[3] "%1 paryškinimai ištrinti iš PDF failo"

#: frontend/apps/reader/modules/readerhighlight.lua:736
