msgctxt "Forced OCR"
msgid "off"
msgstr "إيقاف"

#: frontend/ui/data/koptoptions.lua:640
msgctxt "Forced OCR"
msgid "on"
msgstr "تشغيل"

#: frontend/ui/data/koptoptions.lua:645
msgid ""
"Force the use of OCR for text selection, even if the document has a text "
