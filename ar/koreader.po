#: frontend/apps/reader/modules/readerlink.lua:514
#: frontend/ui/data/css_tweaks.lua:651
msgid "Links"
msgstr "روابط"

#: frontend/apps/reader/modules/readerlink.lua:517
msgid "Tap to follow links"
msgstr "انقر لمتابعة الروابط"

#: frontend/apps/reader/modules/readerlink.lua:523
msgid "Tap on links to follow them."
msgstr "انقر على الروابط لمتابعتها."

#: frontend/apps/reader/modules/readerlink.lua:526
msgid "Ignore external links on tap"
msgstr "تجاهل الروابط الخارجية عند النقر"

#: frontend/apps/reader/modules/readerlink.lua:533
msgid ""
"Ignore taps on external links. Useful with Wikipedia EPUBs to make page "
"turning easier.\n"
"You can still follow them from the dictionary window or the selection menu "
"after holding on them."
msgstr ""
"تجاهل النقرات على الروابط الخارجية. مفيد مع ملفات EPUB من ويكيبيديا لتسهيل "
"تصفح الصفحات.\n"
"يمكنك متابعة هذه الروابط من نافذة القاموس أو قائمة الاختيار بعد الضغط عليها."

#: frontend/apps/reader/modules/readerlink.lua:539
msgid "Swipe to go back"
msgstr "اسحب للعودة"

#: frontend/apps/reader/modules/readerlink.lua:545
msgid ""
"Swipe to the right to go back to the previous location after you have "
"followed a link. When the location stack is empty, swiping to the right "
"takes you to the previous page."
msgstr ""
"اسحب لليمين للعودة إلى الموقع السابق بعد متابعة رابط. عندما يكون تكدس "
"المواقع فارغًا، فإن السحب لليمين ينقلك إلى الصفحة السابقة."

#: frontend/apps/reader/modules/readerlink.lua:548
msgid "Swipe to follow nearest link"
msgstr "اسحب لمتابعة أقرب رابط"

#: frontend/apps/reader/modules/readerlink.lua:554
msgid ""
"Swipe to the left to follow the link nearest to where you started the swipe. "
"This is useful when a small font is used and tapping on small links is "
"tedious."
msgstr ""
"اسحب لليسار لمتابعة الرابط الأقرب لمكان بدء السحب. هذا مفيد عند استخدام خط "
"صغير يجعل النقر على الروابط الصغيرة أمرًا مرهقًا."

#: frontend/apps/reader/modules/readerlink.lua:557
msgid "Ignore external links on swipe"
msgstr "تجاهل الروابط الخارجية عند السحب"

#: frontend/apps/reader/modules/readerlink.lua:564
msgid ""
"Ignore external links near swipe. Useful with Wikipedia EPUBs to follow only "
"footnotes with swipe.\n"
"You can still follow external links from the dictionary window or the "
"selection menu after holding on them."
msgstr ""
"تجاهل الروابط الخارجية القريبة من السحب. مفيد مع ملفات EPUB ويكيبيديا "
"لمتابعة الهوامش فقط عن طريق السحب.\n"
"لا يزال بإمكانك متابعة الروابط الخارجية من نافذة القاموس أو قائمة الاختيار "
"بعد الضغط الطويل عليها."

#: frontend/apps/reader/modules/readerlink.lua:570
msgid "Swipe to jump to latest bookmark"
msgstr "اسحب للقفز إلى آخر علامة تبويب"

#: frontend/apps/reader/modules/readerlink.lua:576
msgid ""
"Swipe to the left to go the most recently bookmarked page.\n"
"This can be useful to quickly swipe back and forth between what you are "
"reading and some reference page (for example notes, a map or a characters "
"list).\n"
"If any of the other Swipe to follow link options is enabled, this will work "
"only when the current page contains no link."
msgstr ""
"اسحب لليسار للانتقال إلى الصفحة الأخيرة التي تمت إضافتها كعلامة تبويب.\n"
"يمكن أن يكون ذلك مفيدًا للسحب بسرعة ذهابًا وإيابًا بين ما تقرأه وبعض الصفحات "
"المرجعية (مثل الملاحظات أو الخريطة أو قائمة الشخصيات).\n"
"إذا تم تفعيل أي من خيارات السحب لمتابعة الروابط الأخرى، فإن هذا الخيار سيعمل "
"فقط عندما لا تحتوي الصفحة الحالية على رابط."

#: frontend/apps/reader/modules/readerlink.lua:591
msgid "Allow larger tap area around links"
msgstr "السماح بمنطقة نقر أكبر حول الروابط"

#: frontend/apps/reader/modules/readerlink.lua:598
msgid ""
"Extends the tap area around internal links. Useful with a small font where "
"tapping on small footnote links may be tedious."
msgstr ""
"توسيع منطقة النقر حول الروابط الداخلية. مفيد مع الخط الصغير حيث قد يكون "
"النقر على روابط الهوامش الصغيرة أمرًا مرهقًا."

