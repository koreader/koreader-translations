#: plugins/gestures.koplugin/main.lua:654
#: plugins/gestures.koplugin/main.lua:660
msgid "Text selection rate"
msgstr "معدل تحديد النص"

#: plugins/gestures.koplugin/main.lua:661
msgid ""
"The rate is how often screen will be refreshed per second while selecting "
"text.\n"
"Higher values mean faster screen updates, but also use more CPU."
msgstr ""
"يمثل المعدل عدد مرات تحديث الشاشة في الثانية أثناء تحديد النص.\n"
"القيم الأعلى تعني تحديثات أسرع للشاشة، ولكنها تستهلك المزيد من وحدة المعالجة "
"المركزية."

#: plugins/gestures.koplugin/main.lua:670
