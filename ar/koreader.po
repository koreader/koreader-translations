#: frontend/ui/data/koptoptions.lua:704
msgid "Document Columns"
msgstr "أعمدة المستند"

#: frontend/ui/data/koptoptions.lua:716
msgid ""
"In reflow mode, sets the max number of columns to try to detect in the "
"original document.\n"
