#: frontend/ui/elements/menu_keyboard_layout.lua:186
#: frontend/ui/widget/bookmarkbrowser.lua:914
#: frontend/ui/widget/buttonselector.lua:93
#: frontend/ui/widget/datetimewidget.lua:80
#: frontend/ui/widget/doublespinwidget.lua:43
#: frontend/ui/widget/radiobuttonwidget.lua:59
#: frontend/ui/widget/spinwidget.lua:37
#: plugins/perceptionexpander.koplugin/main.lua:142
#: plugins/wallabag.koplugin/main.lua:1615
#: plugins/wallabag.koplugin/main.lua:1663
msgid "Apply"
msgstr "تطبيق"

#: frontend/apps/reader/modules/readerstyletweak.lua:1008
msgid "Book tweak not modified."
msgstr "لم يتم تعديل ضبط الكتاب."

#: frontend/apps/reader/modules/readerstyletweak.lua:1010
#: frontend/dispatcher.lua:250
msgid "Edit book-specific style tweak"
msgstr "تعديل تحسينات نمط الكتاب"

#: frontend/apps/reader/modules/readerstyletweak.lua:1179
#: frontend/apps/reader/readerui.lua:654
msgid "Restore"
msgstr "استعادة"

#: frontend/apps/reader/modules/readerstyletweak.lua:1181
msgid "Book tweak restored"
msgstr "تم استعادة ضبط الكتاب."

#: frontend/apps/reader/modules/readerstyletweak.lua:1199
msgid "Book tweak created, applying…"
msgstr "تم إنشاء ضبط الكتاب، جاري التطبيق…"

#: frontend/apps/reader/modules/readerstyletweak.lua:1205
msgid "Book tweak removed, rendering…"
msgstr "تم إزالة تعديل الكتاب، جاري العرض…"

#: frontend/apps/reader/modules/readerstyletweak.lua:1207
msgid "Book tweak emptied and removed."
msgstr "تم إفراغ وتعديل الكتاب ثم إزالته."

#: frontend/apps/reader/modules/readerstyletweak.lua:1213
msgid "Book tweak updated, applying…"
msgstr "تم تحديث تعديل الكتاب، جاري التطبيق…"

#: frontend/apps/reader/modules/readerstyletweak.lua:1215
msgid "Book tweak saved (not enabled)."
msgstr "تم حفظ تعديل الكتاب (غير مفعل)."

#: frontend/apps/reader/modules/readerthumbnail.lua:73
#: frontend/dispatcher.lua:210 frontend/ui/widget/bookmapwidget.lua:778
msgid "Book map"
msgstr "خريطة الكتاب"

#: frontend/apps/reader/modules/readerthumbnail.lua:86
#: frontend/dispatcher.lua:212 frontend/ui/widget/pagebrowserwidget.lua:37
msgid "Page browser"
msgstr "مستعرض الصفحات"

#: frontend/apps/reader/modules/readertoc.lua:69 frontend/dispatcher.lua:209
msgid "Table of contents"
msgstr "الفهرس"

#: frontend/apps/reader/modules/readertoc.lua:979
msgid "Include all chapters in regular flow"
msgstr "إدراج جميع الفصول في التدفق العادي"

#: frontend/apps/reader/modules/readertoc.lua:989
msgid "Include chapter in regular flow"
msgstr "إدراج الفصل في التدفق العادي"

#: frontend/apps/reader/modules/readertoc.lua:999
msgid "Include chapter in hidden flow"
msgstr "إدراج الفصل في التدفق المخفي"

#: frontend/apps/reader/modules/readertoc.lua:1205
msgid "No results in table of contents"
msgstr "لا توجد نتائج في الفهرس"

#: frontend/apps/reader/modules/readertoc.lua:1324
msgid "Alternative table of contents"
msgstr "فهرس بديل"

#: frontend/apps/reader/modules/readertoc.lua:1326
msgid ""
"An alternative table of contents can be built from document headings <H1> to "
"<H6>.\n"
"If the document contains no headings, or all are ignored, the alternative "
"ToC will be built from document fragments and will point to the start of "
"each individual HTML file in the EPUB.\n"
"\n"
"Some of the headings can be ignored, and hints can be set to other non-"
"heading elements in a user style tweak, so they can be used as ToC items.\n"
"See Style tweaks → Miscellaneous → Alternative ToC hints."
msgstr ""
"يمكن إنشاء فهرس بديل من عناوين المستند <H1> إلى <H6>.\n"
"إذا لم يحتوي المستند على عناوين، أو تم تجاهلها جميعًا، سيتم إنشاء الفهرس "
"البديل من أجزاء المستند وسيشير إلى بداية كل ملف HTML فرعي في EPUB.\n"
"\n"
"يمكن تجاهل بعض العناوين، ويمكن تعيين إشارات إلى عناصر غير عناوين أخرى في "
"تعديل نمط المستخدم، بحيث يمكن استخدامها كعناصر في الفهرس.\n"
"انظر تعديلات النمط ← متنوعة ← إشارات الفهرس البديل."

#: frontend/apps/reader/modules/readertoc.lua:1333
msgid ""
"To use the alternative ToC, disable your custom table of contents first."
msgstr "للاستفادة من الفهرس البديل، قم بإلغاء تفعيل فهرسك المخصص أولاً."

#: frontend/apps/reader/modules/readertoc.lua:1347
msgid ""
"The table of contents for this book is currently an alternative one built "
"from the document headings.\n"
"Do you want to get back the original table of contents? (The book will be "
"reloaded.)"
msgstr ""
"الفهرس الخاص بهذا الكتاب هو حالياً فهرس بديل مبني من عناوين المستند.\n"
