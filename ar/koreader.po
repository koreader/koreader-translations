msgctxt "Quality"
msgid "low"
msgstr "منخفضة"

#: frontend/ui/data/koptoptions.lua:607
msgctxt "Quality"
msgid "default"
msgstr "افتراضي"

#: frontend/ui/data/koptoptions.lua:607
msgctxt "Quality"
msgid "high"
msgstr "عالية"

#: frontend/ui/data/koptoptions.lua:615
msgid ""
